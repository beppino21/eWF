<?xml version="1.0" encoding="utf-8"?>
<t:layoutdefinition xmlns:t="http://www.captaincasa.com/controllibrary/t" >

<t:beanprocessing id="w_1" beanbinding="#{d.WorklistUI}" />
<t:rowtitlebar id="w_2" text="Attivita' da approvare" />
<t:rowheader id="w_3" >
<t:button id="w_3m" actionListener="#{d.WorklistUI.onBackToMenu}" text="« Menu" width="80" />
<t:coldistance id="w_3md" width="12" />
<t:link id="w_3r" actionListener="#{d.WorklistUI.onResetFilters}" rendered="#{d.WorklistUI.filtered}" text="Togli filtri" />
<t:coldistance id="w_3d" width="100%" />
<t:button id="w_3f" actionListener="#{d.WorklistUI.onRefresh}" text="Aggiorna" width="80" />
</t:rowheader>
<t:rowdistance id="w_4" height="10" />
<t:rowbodypane id="w_5" >
<t:row id="w_6" >
<t:label id="w_6l" font="weight:bold" text="#{d.WorklistUI.status}" />
<t:coldistance id="w_6c" width="100%" />
<t:link id="w_6x" actionListener="#{d.WorklistUI.grid.onEditColumnDetails}" text="Colonne..." />
<t:coldistance id="w_6d" />
<t:link id="w_6y" actionListener="#{d.WorklistUI.grid.onOpenGridExportFunctions}" text="Export" />
</t:row>
<t:row id="w_7" >
<t:fixgrid id="w_g" height="100%" objectbinding="#{d.WorklistUI.grid}" persistid="EWF_WORKLIST_GRID" sbvisibleamount="30" width="100%" >
<t:gridheader id="w_gh" rendered="true" rowheight="30" >
<t:field id="w_h0" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterDays}" />
<t:field id="w_h1" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterProcess}" />
<t:field id="w_h2" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterDocument}" />
<t:label id="w_hb" background="#C0C0C0" />
<t:field id="w_h3" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.summaryVisible}" text="#{d.WorklistUI.filterSummary}" />
<t:field id="w_hx1" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col1}" text="#{d.WorklistUI.filterCol1}" />
<t:field id="w_hx2" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col2}" text="#{d.WorklistUI.filterCol2}" />
<t:field id="w_hx3" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col3}" text="#{d.WorklistUI.filterCol3}" />
<t:field id="w_hx4" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col4}" text="#{d.WorklistUI.filterCol4}" />
<t:field id="w_hx5" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col5}" text="#{d.WorklistUI.filterCol5}" />
<t:field id="w_hx6" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" rendered="#{d.WorklistUI.col6}" text="#{d.WorklistUI.filterCol6}" />
<t:field id="w_h4" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterTask}" />
<t:field id="w_h5" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterForWhom}" />
<t:field id="w_h6" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterStarter}" />
<t:field id="w_h7" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterValue}" />
<t:field id="w_h8" actionListener="#{d.WorklistUI.onColFilter}" background="#b4c6e7" flush="true" flushtimer="800" text="#{d.WorklistUI.filterSince}" />
<t:label id="w_h9" background="#C0C0C0" />
</t:gridheader>
<t:gridcol id="w_c0" sortreference=".{daysSort}" text="Giorni" width="60" >
<t:label id="w_c0l" align="center" background=".{lightColor}" font="weight:bold" text=".{days}" />
</t:gridcol>
<t:gridcol id="w_c1" text="Processo" width="170" >
<t:label id="w_c1l" text=".{processType}" />
</t:gridcol>
<t:gridcol id="w_c2" text="Documento" width="100" >
<t:label id="w_c2l" font="weight:bold" text=".{document}" />
</t:gridcol>
<t:gridcol id="w_cb" text="" width="290" >
<t:pane id="w_cbp" width="100%" >
<t:row id="w_cbr" coldistance="4" >
<t:button id="w_cb1" actionListener=".{onAttachments}" background=".{attachmentsBg}" enabled=".{attachmentsEnabled}" font="size:10" text=".{attachmentsText}" width="85" />
<t:button id="w_cb3" actionListener=".{onComments}" background=".{commentsBg}" enabled=".{commentsEnabled}" font="size:10" text=".{commentsText}" width="95" />
<t:button id="w_cb2" actionListener=".{onHistory}" background=".{historyBg}" enabled=".{historyEnabled}" font="size:10" text=".{historyText}" width="85" />
</t:row>
</t:pane>
</t:gridcol>
<t:gridcol id="w_c3" rendered="#{d.WorklistUI.summaryVisible}" text="Riepilogo" width="340" >
<t:label id="w_c3l" text=".{summary}" />
</t:gridcol>
<t:gridcol id="w_x1" rendered="#{d.WorklistUI.col1}" text="#{d.WorklistUI.colLabel1}" width="140" >
<t:label id="w_x1l" text=".{col1}" />
</t:gridcol>
<t:gridcol id="w_x2" rendered="#{d.WorklistUI.col2}" text="#{d.WorklistUI.colLabel2}" width="140" >
<t:label id="w_x2l" text=".{col2}" />
</t:gridcol>
<t:gridcol id="w_x3" rendered="#{d.WorklistUI.col3}" text="#{d.WorklistUI.colLabel3}" width="140" >
<t:label id="w_x3l" text=".{col3}" />
</t:gridcol>
<t:gridcol id="w_x4" rendered="#{d.WorklistUI.col4}" text="#{d.WorklistUI.colLabel4}" width="140" >
<t:label id="w_x4l" text=".{col4}" />
</t:gridcol>
<t:gridcol id="w_x5" rendered="#{d.WorklistUI.col5}" text="#{d.WorklistUI.colLabel5}" width="140" >
<t:label id="w_x5l" text=".{col5}" />
</t:gridcol>
<t:gridcol id="w_x6" rendered="#{d.WorklistUI.col6}" text="#{d.WorklistUI.colLabel6}" width="140" >
<t:label id="w_x6l" text=".{col6}" />
</t:gridcol>
<t:gridcol id="w_c4" text="Attivita'" width="220" >
<t:label id="w_c4l" text=".{taskText}" />
</t:gridcol>
<t:gridcol id="w_c5" text="Per conto di" width="140" >
<t:label id="w_c5l" background=".{forWhomBackground}" text=".{forWhom}" />
</t:gridcol>
<t:gridcol id="w_c6" text="Richiedente" width="140" >
<t:label id="w_c6l" text=".{starter}" />
</t:gridcol>
<t:gridcol id="w_c7" sortreference=".{valueSort}" text="Valore" width="120" >
<t:label id="w_c7l" align="right" text=".{value}" />
</t:gridcol>
<t:gridcol id="w_c8" sortreference=".{sinceSort}" text="In attesa dal" width="95" >
<t:label id="w_c8l" text=".{since}" />
</t:gridcol>
<t:gridcol id="w_c9" text="" width="70" >
<t:button id="w_c9b" actionListener=".{onOpen}" text="Apri" width="60" />
</t:gridcol>
</t:fixgrid>
</t:row>
</t:rowbodypane>

</t:layoutdefinition>
